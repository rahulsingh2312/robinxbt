# HTTP server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATA_FILE=./data/store.json
# Production: required. The JSON fallback is for local development only; it
# holds encrypted wallet keys in a single unsynced file with no backups.
# Copy an existing JSON store in with `npm run db:migrate`.
DATABASE_URL=postgres://user:password@localhost:5432/xbot

# Use a long random value. It protects initial user provisioning.
ADMIN_API_KEY=replace-with-a-long-random-secret

# X bot account. Credentials must belong to the bot account itself and be
# allowed to read mentions and create Posts.
X_BOT_USER_ID=
X_BOT_USERNAME=yourbot
# Each poll is a billed read (~$0.005). 60s is ~43k reads/month.
X_POLL_INTERVAL_MS=60000

# OAuth 1.0a (simplest for a single bot posting only as itself). Generate all
# four in the X developer portal under Keys and tokens, with app permissions set
# to Read and write BEFORE generating the access token.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# OAuth 2.0 user-context token, if you run that flow instead. An app-only
# Bearer token does NOT work here: it cannot post or read mentions as the bot.
X_BOT_USER_ACCESS_TOKEN=

# Multiple bots (preferred for a bot fleet). When present, this overrides the
# single-bot values above. Each token must belong to the matching bot account.
# X_BOTS_JSON=[{"username":"firstbot","userId":"123","userAccessToken":"token-a"},{"username":"secondbot","userId":"456","userAccessToken":"token-b"}]

# Set true while validating web pages and API setup without calling X.
# While true the bot also never places a real order; it logs what it would do.
X_DRY_RUN=true

# ---------------------------------------------------------------------------
# Trading (single account: YOUR Robinhood agentic account, YOUR money)
# ---------------------------------------------------------------------------
# Orders execute instantly with no confirmation reply, so the allowlist and the
# caps below are the only things standing between a tweet and a filled order.
TRADING_ENABLED=false

# Numeric X user IDs allowed to place orders, comma separated. NOT handles:
# a handle can be changed and then re-registered by someone else. Find yours at
# https://api.x.com/2/users/by/username/YOUR_HANDLE
X_TRADE_AUTHOR_IDS=

# Hard spend limits. A buy over MAX_ORDER_USD is refused; buys are summed per
# UTC day against DAILY_MAX_USD. Start small.
MAX_ORDER_USD=100
DAILY_MAX_USD=500

# Written by `npm run robinhood:login`. Contains a refresh token that can place
# trades: keep it 0600 and never commit it.
ROBINHOOD_TOKEN_FILE=./data/robinhood-tokens.json
ROBINHOOD_CALLBACK_PORT=41999

# Only if Robinhood ever issues you a static OAuth client. Leave blank to let
# the SDK register dynamically.
ROBINHOOD_CLIENT_ID=
ROBINHOOD_CLIENT_SECRET=

# Pin MCP tool names if Robinhood renames them and auto-discovery misses.
# `npm run robinhood:login` prints the live names and current mappings.
ROBINHOOD_TOOL_PLACEORDER=
ROBINHOOD_TOOL_QUOTE=
ROBINHOOD_TOOL_POSITIONS=
ROBINHOOD_TOOL_ACCOUNT=

# "paper" (default) simulates fills per X user, priced from live quotes.
# "live" is the ONLY value that places real orders.
TRADING_MODE=paper

# ---------------------------------------------------------------------------
# On-chain wallets (one Robinhood Chain wallet per interacting X user)
# ---------------------------------------------------------------------------
# When true, every user who mentions the bot gets a custodial wallet on
# Robinhood Chain (chain id 4663). Buys fill from THEIR deposited ETH via
# Uniswap v4; the operator-account trading section above is bypassed.
# You are holding other people's keys and money: read the README section
# "On-chain wallets" before enabling, and mind the regulatory notes there.
ONCHAIN_ENABLED=false

# Encrypts every stored private key (AES-256-GCM). Generate with:
#   openssl rand -hex 32
# Losing this key means losing every user wallet. Back it up offline.
WALLET_ENC_KEY=

# Robinhood Chain endpoints. The public RPC is rate limited; use a dedicated
# provider (QuickNode/Chainstack/dRPC…) in production.
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_EXPLORER=https://robinhoodchain.blockscout.com

# Per-order ceiling for tweet-triggered buys.
ONCHAIN_MAX_ORDER_USD=100

# Slippage is sized per trade from how much the pool actually moves, between
# these two bounds. The floor applies to deep pools (stock tokens fill inside
# it); the ceiling stops a thin pool from becoming a blank cheque.
ONCHAIN_SLIPPAGE_BPS=50
ONCHAIN_MAX_SLIPPAGE_BPS=500
# ETH kept back for gas so a buy never strands the wallet unable to move.
ONCHAIN_GAS_RESERVE_ETH=0.0002
# Refuse fills worse than this against the indexed price. Issuer-verified
# tokens trade in deep pools and should never need much; unverified tokens get
# more room, and the user is told what the impact cost them.
ONCHAIN_MAX_PRICE_IMPACT_BPS=150
ONCHAIN_MAX_PRICE_IMPACT_UNVERIFIED_BPS=5000

# Put the deposit address straight into funding replies so someone can top up
# without leaving the conversation. X refuses posts containing an address for
# the first week after an app authenticates; the bot notices and re-sends the
# same answer pointing at the portfolio page, so this can stay on.
ONCHAIN_ADDRESS_IN_REPLIES=true

# Portfolio site (web/). The site proxies /api and /auth to this server, so
# SITE_BASE_URL is the public origin USERS see, and it is what the X OAuth
# redirect URI must be registered as: {SITE_BASE_URL}/auth/x/callback
SITE_BASE_URL=http://localhost:3100

# X OAuth 2.0 client (developer portal > your app > OAuth 2.0). Enables
# "Sign in with X" on the site for withdrawals and key export. Optional:
# without it the site is read-only.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Session cookie signing secret. Leave blank to derive one from WALLET_ENC_KEY,
# or set at least 32 bytes: openssl rand -hex 32
SESSION_SECRET=

# Shared with the site's proxy (set the SAME value in the site's environment).
# When set, the wallet API refuses any request that did not come through the
# site, which stops direct enumeration on the public port and makes the
# forwarded client IP trustworthy for rate limiting. openssl rand -hex 32
PROXY_SHARED_SECRET=

# Set both to rotate the wallet encryption key: put the OLD key here, generate
# a new WALLET_ENC_KEY, restart, then run `npm run wallets:rewrap` and remove
# this line. Without it, changing WALLET_ENC_KEY makes every wallet unusable.
WALLET_ENC_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# Answering brain
# ---------------------------------------------------------------------------
# Free-form mentions are answered by an LLM with read-only Robinhood tools.
LLM_ENABLED=false
LLM_API_KEY=
# Defaults: https://api.deepseek.com and deepseek-v4-pro.
LLM_BASE_URL=
LLM_MODEL_NAME=

# Fallback answerer: the insiders agent. Each turn burns credits, so opt-in.
INSIDERS_ENABLED=false
INSIDERS_JWT_SECRET=
INSIDERS_USER_ID=
AGENT_BASE_URL=

# App-only bearer token. Used for the filtered stream and for reading the
# style-corpus timeline; it cannot post or read mentions.
X_APP_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Persona: Gork (parody rage-bait voice)
# ---------------------------------------------------------------------------
# "default" keeps the original dry voice; "gork" swaps in the parody persona.
# The bot account MUST be labeled as a parody in its X profile — an unlabeled
# parody account gets suspended under the impersonation policy.
PERSONA=default

# Unprompted posts on a randomized cadence. Each post costs ~$0.015 on X's
# pay-per-use pricing, so this is opt-in and respects X_DRY_RUN.
GORK_POSTING_ENABLED=false
GORK_POST_MIN_MINUTES=35
GORK_POST_MAX_MINUTES=95

# How far up a reply chain the bot reads for context. The first hop is free;
# each further hop costs one billed X read. 1-6.
CONTEXT_THREAD_DEPTH=3

# Numeric X user ID of the public figure the parody tracks (style reference
# only). Reads bill per post returned; the cache TTL keeps it at pennies.
CORPUS_X_USER_ID=
CORPUS_MAX_POSTS=15
CORPUS_REFRESH_HOURS=12
