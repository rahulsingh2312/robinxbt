{
  "name": "xbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "robinhood:login": "node --env-file-if-exists=.env src/robinhood-login.js",
    "test": "node --test",
    "wallets:rewrap": "node --env-file-if-exists=.env src/rewrap-wallets.js",
